[submodule "gemfot-contract/lib/v4-core"]
	path = gemfot-contract/lib/v4-core
	url = https://github.com/Uniswap/v4-core
[submodule "gemfot-contract/lib/openzeppelin-contracts-upgradeable"]
	path = gemfot-contract/lib/openzeppelin-contracts-upgradeable
