# ---------------------------------------------------------------------------- #
#                     GemFot protocol environment (arc_testnet)                #
# ---------------------------------------------------------------------------- #
#
# Both `./script/deploy.sh` and `./script/verify.sh` source this file automatically.
#
# Replace every "PLACEHOLDER_*" value. Values are quoted so `source .env` never chokes on
# `<`, `>` or `#`. This file is gitignored, never commit it.

# ---------------------------------------------------------------------------- #
#                              NETWORK / SIGNER                                #
# ---------------------------------------------------------------------------- #
NETWORK="arc_testnet"
RPC_URL="https://arc-testnet.drpc.org"
CHAIN_ID="5042002"

# `cast wallet address --account <name>`
KEYSTORE_ACCOUNT="PLACEHOLDER_KEYSTORE_ACCOUNT"
DEPLOYER="PLACEHOLDER_DEPLOYER_ADDRESS"

# ---------------------------------------------------------------------------- #
#                            VERIFICATION (optional)                           #
# ---------------------------------------------------------------------------- #
VERIFY="false"
VERIFIER="blockscout"
VERIFIER_URL="https://testnet.arcscan.app/api"
ETHERSCAN_API_KEY="PLACEHOLDER_ETHERSCAN_API_KEY"

# Must match [profile.default] in foundry.toml
COMPILER_VERSION="0.8.26"
OPTIMIZER_RUNS="0"
EVM_VERSION="cancun"

# ---------------------------------------------------------------------------- #
#                             PROTOCOL PARAMETERS                              #
# ---------------------------------------------------------------------------- #
# EOA owning the protocol contracts
PROTOCOL_OWNER="PLACEHOLDER_PROTOCOL_OWNER_ADDRESS"

# USDC on arc_testnet
NATIVE_TOKEN="PLACEHOLDER_USDC_ADDRESS"

# Uniswap V4 PoolManager on arc_testnet
POOL_MANAGER="0xC8d4D8fd9121D92ba790A70a60c07143A2C0Cd98"

# Fee distribution defaults used by {GemFotManager}
SWAP_FEE="300"                 # 3.00%
PROTOCOL_FEE="200"             # 2.00%
FEE_DISTRIBUTION_ACTIVE="true"

# {Launch} ERC721 metadata base URI, e.g. https://api.gemfot.xyz/metadata/
BASE_URI="PLACEHOLDER_BASE_URI"

# ---------------------------------------------------------------------------- #
#                              DEPLOYED ADDRESSES                              #
# ---------------------------------------------------------------------------- #
# Left blank for a fresh deploy (deploy.sh exports each one as it goes).
# Fill these in from the deploy.sh summary block before running ./script/verify.sh.

INITIAL_PRICE=""                        # USDCMarketCappedPrice
FEE_EXEMPTIONS=""                       # FeeExemptions
ACTION_MANAGER=""                       # TreasuryActionManager
INDEXER=""                              # IndexerSubscriber
FEE_ESCROW=""                           # FeeEscrow
FEE_ESCROW_REGISTRY=""                  # FeeEscrowRegistry
PROTOCOL_FEE_RECIPIENT=""               # ProtocolFeeRecipient
FAIR_LAUNCH=""                          # FairLaunch
BID_WALL=""                             # BidWall
MEMECOIN_IMPLEMENTATION=""              # Memecoin (implementation)
MEMECOIN_TREASURY_IMPLEMENTATION=""     # MemecoinTreasury (implementation)
GEMFOT_MANAGER=""                       # GemFotManager (hook)
LAUNCH=""                               # Launch
NOTIFIER=""                             # Notifier (deployed by GemFotManager)
PREVENT_NO_FAIR_LAUNCH=""               # PreventNoFairLaunch
POOL_SWAP=""                            # PoolSwap
BLANK_ACTION=""                         # BlankAction
BURN_TOKENS_ACTION=""                   # BurnTokensAction
BUY_BACK_ACTION=""                      # BuyBackAction
